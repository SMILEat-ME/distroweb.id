---
import Layout from '../layouts/Layout.astro';
---
<Layout>
<!-- TOP NAVIGATION BAR -->
    <header class="topbar">
        <div class="topbar-inner">
            <a href="#" class="brand" aria-label="Beranda Distro Web">
                <img src="/logo.png" alt="Logo Distro Web" class="brand-logo" width="42" height="42">
                <span class="brand-name">DISTRO<span>WEB</span></span>
            </a>
            <div class="topbar-actions">
                <button class="theme-toggle" id="theme-btn" aria-label="Ganti mode warna terang/gelap"
                    title="Ganti Mode Terang / Gelap">
                    <span id="theme-icon">◐</span>
                </button>
                <a class="btn btn-nav"
                    href="https://wa.me/6285183324266?text=Halo%20Distro%20Web%2C%20mau%20konsultasi%20website"
                    target="_blank" rel="noopener">Chat WA</a>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="hero">
        <div class="hero-content">
            <div class="kicker">
                <span class="kicker-tag">EST. 2026</span>
                <span>100% HAND-CRAFTED • ZERO TEMPLATE</span>
            </div>
            <h1><span>Bukan</span> <span>baju</span> <span>obral.</span></h1>
            <p>Template website itu kayak baju obral dipakai ribuan bisnis, jadi ibarat baju potongannya seragam semua.
                Sementara disini websitemu kami jahit dari nol biar pas sama karakter brand dan audiensmu!</p>
            <div class="hero-actions">
                <a class="btn" href="#paket">Pilih Potonganmu</a>
                <a class="btn btn-secondary" href="#hitung">Hitung Biaya Sendiri</a>
            </div>
        </div>

        <div class="hero-visual">
            <div class="visual-board" id="vboard">
                <div class="sticker sticker-1">ANTI TEMPLATE CLUB</div>
                <div class="sticker sticker-3">100% CLEAN CODE</div>
                <div class="sticker sticker-2">MADE IN BANDUNG ★</div>

                <!-- Realistic Interactive Swinging Hangtag -->
                <div class="hangtag-container">
                    <div class="hangtag-string"></div>
                    <div class="hangtag" id="tag">
                        <div class="hangtag-hole"></div>
                        <div class="hangtag-brand">DISTRO WEB</div>
                        <div class="hangtag-subtitle">CUSTOM CODEWEAR</div>
                        <hr class="hangtag-divider">
                        <div class="hangtag-meta">
                            <span>ART: 001-TAILOR</span>
                            <span>LOT: BDG-2026</span>
                        </div>
                        <div class="barcode" aria-hidden="true">
                            <span class="w2"></span><span class="sp"></span>
                            <span class="w1"></span><span class="w3"></span><span class="sp"></span>
                            <span class="w2"></span><span class="w1"></span><span class="sp"></span>
                            <span class="w3"></span><span class="w1"></span><span class="w2"></span><span
                                class="sp"></span>
                            <span class="w1"></span><span class="w2"></span><span class="w3"></span>
                        </div>
                        <div class="barcode-code">DW-BDG-2026-X</div>
                        <div class="hangtag-seal">CERTIFIED ORIGINAL</div>
                    </div>
                </div>

                <!-- Mascot Si Kursor -->
                <div class="mascot-wrap">
                    <svg class="mascot" id="m" viewBox="0 0 200 240" role="img"
                        aria-label="Si Kursor, maskot Distro Web yang ngantuk">
                        <path d="M40 14 L168 128 L112 132 L130 188 L100 198 L82 142 L40 176 Z" fill="#0E2A1A"
                            transform="translate(7 7)" />
                        <path d="M40 14 L168 128 L112 132 L130 188 L100 198 L82 142 L40 176 Z" fill="#F2EBD3"
                            stroke="#0E2A1A" stroke-width="5" stroke-linejoin="round" />
                        <g class="eye" id="eye">
                            <path d="M62 82q9 -8 18 0M92 98q9 -8 18 0" stroke="#0E2A1A" stroke-width="5" fill="none"
                                stroke-linecap="round" />
                            <circle cx="71" cy="86" r="3" fill="#0E2A1A" />
                            <circle cx="101" cy="102" r="3" fill="#0E2A1A" />
                        </g>
                        <path d="M76 112q12 10 24 2" stroke="#0E2A1A" stroke-width="4" fill="none"
                            stroke-linecap="round" />
                        <path d="M92 196l-4 30h18M120 188l12 36h16" stroke="#0E2A1A" stroke-width="6" fill="none"
                            stroke-linecap="round" />
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <!-- TICKER STRIPE -->
    <div class="stripe" aria-hidden="true">
        <div>Different Looks. Different Links. &nbsp;★&nbsp; Studio website dari Bandung, 2026 &nbsp;★&nbsp; 100% Custom
            Code, No Template &nbsp;★&nbsp; Different Looks. Different Links. &nbsp;★&nbsp; Studio website dari Bandung,
            2026 &nbsp;★&nbsp; 100% Custom Code, No Template &nbsp;★&nbsp;</div>
    </div>

    <!-- SECTION: BEDA (BROWSER WINDOW MOCKUP) -->
    <section id="beda">
        <h2>Geser, lihat bedanya.</h2>
        <p style="margin-top:14px">Bisnis yang sama, dua jahitan berbeda. Kiri template gratisan yang dipakai ribuan
            orang, kanan website yang kami jahit khusus. Geser sendiri garisnya!</p>

        <div class="cmp-wrapper">
            <div class="cmp-browser-bar">
                <div class="browser-dots">
                    <span class="browser-dot red"></span>
                    <span class="browser-dot yellow"></span>
                    <span class="browser-dot green"></span>
                </div>
                <div class="browser-url-bar">
                    <span>🔒 https://distroweb.id/compare-preview</span>
                    <span>HTML5 • ULTRA FAST</span>
                </div>
            </div>

            <div class="cmp" id="cmp">
                <!-- BEFORE: bisnis yang sama, pakai template gratisan pasaran -->
                <div class="site tpl">
                    <div class="tpl-top">
                        <span>📞 (022) 123-4567 &nbsp;·&nbsp; ✉ info@kedaikopisenja.com</span>
                        <span>f &nbsp; t &nbsp; in</span>
                    </div>
                    <div class="tpl-nav">
                        <div class="tpl-logo"><span class="tpl-logo-icon">☕</span> Kedai Kopi Senja</div>
                        <div class="tpl-links">
                            <span class="on">Home</span><span>About
                                Us</span><span>Services</span><span>Gallery</span><span>Contact</span>
                        </div>
                    </div>
                    <div class="tpl-hero">
                        <span class="tpl-arrow l">‹</span>
                        <div>
                            <div class="tpl-title">Selamat Datang di Website Kami</div>
                            <p class="tpl-desc">Kami adalah perusahaan yang bergerak di bidang kopi. Kami berkomitmen
                                memberikan pelayanan terbaik dan produk berkualitas untuk kepuasan pelanggan.</p>
                            <div class="tpl-actions">
                                <span class="tpl-btn">Read More</span>
                                <span class="tpl-btn-o">Contact Us</span>
                            </div>
                        </div>
                        <span class="tpl-arrow r">›</span>
                        <div class="tpl-dots"><i></i><i></i><i></i></div>
                    </div>
                    <div class="tpl-feats">
                        <div class="tpl-feat"><i>★</i><b>Kualitas Terbaik</b>Lorem ipsum dolor sit amet.</div>
                        <div class="tpl-feat"><i>$</i><b>Harga Terjangkau</b>Consectetur adipiscing elit.</div>
                        <div class="tpl-feat"><i>♥</i><b>Pelayanan Ramah</b>Sed do eiusmod tempor.</div>
                    </div>
                    <div class="tpl-foot">© 2026 Kedai Kopi Senja · Powered by FreeTheme Template #1428</div>
                </div>

                <!-- AFTER: bisnis yang sama, dijahit custom oleh Distro Web -->
                <div class="site cus" id="cus">
                    <div class="cus-glow"></div>
                    <div class="cus-nav">
                        <div class="cus-logo"><span>senja<em>.</em></span><small>Coffee Roasters</small></div>
                        <div class="cus-links">
                            <span>Menu</span><span>Origin</span><span>Wholesale</span><span>Kunjungi</span>
                        </div>
                        <span class="cus-nav-cta">Reservasi →</span>
                    </div>
                    <div class="cus-hero">
                        <div>
                            <div class="cus-title">Kopi jujur dari <em>lereng Puntang</em>, diseduh untuk harimu.</div>
                            <p class="cus-desc">Single origin dari petani lokal, disangrai segar tiap minggu, dan
                                disajikan barista yang hafal pesanan favoritmu.</p>
                            <div class="cus-proof" style="margin-top: 22px;">
                                <div class="cus-avatars"><i></i><i></i><i></i><i></i></div>
                                <div><b>4.9 <span>★★★★★</span></b>2.300+ ulasan di Google</div>
                            </div>
                        </div>
                        <div class="cus-visual">
                            <svg class="cus-ring" viewBox="0 0 200 200" aria-hidden="true">
                                <defs>
                                    <path id="cusCircle" d="M100,100 m-88,0 a88,88 0 1,1 176,0 a88,88 0 1,1 -176,0" />
                                </defs>
                                <text>
                                    <textPath href="#cusCircle">FRESH ROASTED WEEKLY • SENJA COFFEE • BANDUNG •
                                    </textPath>
                                </text>
                            </svg>
                            <div class="cus-saucer"></div>
                            <div class="cus-cup">
                                <div class="cus-coffee">
                                    <div class="cus-heart"></div>
                                </div>
                            </div>
                            <div class="cus-chip c1">⛰️<div><small>Origin</small>Puntang · 1.400 mdpl</div>
                            </div>
                            <div class="cus-chip c2">🍫<div><small>Tasting Notes</small>Cokelat · Jeruk · Aren</div>
                            </div>
                            <div class="cus-chip c3">🔥<div><small>Drop Batch #04</small>Diskon 15%</div>
                            </div>
                        </div>
                    </div>
                    <div class="cus-marquee" aria-hidden="true">
                        <div>Single Origin<span>✦</span>Manual Brew<span>✦</span>Roasted Weekly<span>✦</span>Workspace
                            &amp; Free Wifi<span>✦</span>Delivery Se-Bandung<span>✦</span>Single
                            Origin<span>✦</span>Manual Brew<span>✦</span>Roasted Weekly<span>✦</span>Workspace &amp;
                            Free Wifi<span>✦</span>Delivery Se-Bandung<span>✦</span></div>
                    </div>
                </div>

                <div class="handle"></div>
                <span class="tag-l">Before: Template Pasaran</span>
                <span class="tag-r">After: Distro Web Custom</span>
                <input type="range" min="0" max="100" value="50" id="rng"
                    aria-label="Geser untuk membandingkan template dan website custom">
            </div>
        </div>
    </section>

    <!-- SECTION: FAQ -->
    <section id="faq">
        <div class="faq-header">
            <h2>Yang Sering Ditanyain, Nih!</h2>
        </div>

        <!-- FAQ Accordion Items -->
        <div class="faq-list">
            <details>
                <summary><span class="faq-num">01</span><span class="faq-q">Kenapa nggak beli template siap pakai
                        aja?</span><span class="faq-toggle">+</span></summary>
                <p class="faq-answer">Template murah memang banyak, tapi resikonya ratusan bisnis lain punya tampilan
                    yang persis sama. Selain itu, template pasaran sering memuat ratusan kode yang nggak kamu butuhkan
                    sehingga loadingnya berat dan peringkat di Google kurang optimal. Di Distro Web, setiap baris kode
                    dijahit khusus hanya untuk bisnismu.</p>
            </details>
            <details>
                <summary><span class="faq-num">02</span><span class="faq-q">Bedanya apa sama software house / agensi
                        besar?</span><span class="faq-toggle">+</span></summary>
                <p class="faq-answer">Agensi besar biasanya menetapkan biaya puluhan hingga ratusan juta karena overhead
                    tim yang besar. Distro Web adalah studio independen di Bandung yang berfokus memberikan kualitas
                    custom sekelas agensi dengan struktur harga yang masuk akal dan bersahabat bagi UMKM dan brand
                    independen.</p>
            </details>
            <details>
                <summary><span class="faq-num">03</span><span class="faq-q">Websitenya 100% jadi milik aku,
                        kan?</span><span class="faq-toggle">+</span></summary>
                <p class="faq-answer">Tentu saja. Domain dan hosting didaftarkan resmi atas nama dan email kamu sendiri.
                    Kamu menerima seluruh akses admin, source code, dan database penuh pada saat Drop Day.</p>
            </details>
            <details>
                <summary><span class="faq-num">04</span><span class="faq-q">Bagaimana sistem pembayarannya?</span><span
                        class="faq-toggle">+</span></summary>
                <p class="faq-answer">Sangat transparan: DP 50% di awal sebelum pola dibuat, dan pelunasan 50% saat
                    website siap online di tahap Drop Day. Setiap proyek dilengkapi penawaran tertulis dan invoice
                    resmi.</p>
            </details>
            <details>
                <summary><span class="faq-num">05</span><span class="faq-q">Berapa lama proses
                        pengerjaannya?</span><span class="faq-toggle">+</span></summary>
                <p class="faq-answer">Tergantung paket: Kaos Polos (landing page) 5–7 hari kerja, Kemeja (company
                    profile) 10–15 hari kerja, Jaket (toko online) 20–30 hari kerja. Semua timeline dicantumkan dalam
                    penawaran tertulis sebelum kita mulai.</p>
            </details>
            <details>
                <summary><span class="faq-num">06</span><span class="faq-q">Kalau website sudah jadi, bisa saya ubah
                        sendiri?</span><span class="faq-toggle">+</span></summary>
                <p class="faq-answer">Bisa! Kamu akan mendapat video tutorial 15 menit yang kami buat khusus sesuai
                    strukturmu. Dan tentunya ada Paket Rawat buat yang ingin bantuan teknis rutin setelah launch.</p>
            </details>
        </div>
    </section>

    <!-- SECTION: ALUR JAHIT -->
    <section id="alur">
        <h2>Dijahit dalam 6 tahap.</h2>
        <p style="margin-top:14px">Kamu selalu tahu lagi sampai mana. Scroll pelan, pita meteran jahit dan Si Kursor
            akan memandu alurnya.</p>
        <div class="tl" id="tl">
            <div class="fill"></div>
            <svg class="cur" viewBox="0 0 60 60" aria-hidden="true">
                <path d="M8 4L52 40 32 42 40 58 30 60 22 44 8 56Z" fill="#F2EBD3" stroke="#0E2A1A" stroke-width="4"
                    stroke-linejoin="round" />
            </svg>
            <div class="st" data-n="1">
                <span class="st-step-badge">STEP 01</span>
                <h3>Ukur Badan</h3>
                <p>Konsultasi gratis 100%. Kamu ceritain visi bisnismu, lalu terima penawaran tertulis: rincian harga,
                    rekomendasi domain & hosting resmi, jatah revisi, dan jadwal pengerjaan.</p>
            </div>
            <div class="st" data-n="2">
                <span class="st-step-badge">STEP 02</span>
                <h3>Bikin Pola</h3>
                <p>Kami buat wireframe arsitektur halaman dan alur pengunjung. Kamu review dan beri lampu hijau sebelum
                    kami masuk ke proses sablon visual.</p>
            </div>
            <div class="st" data-n="3">
                <span class="st-step-badge">STEP 03</span>
                <h3>Sablon Desain</h3>
                <p>Desain visual berkarakter streetwear distingtif yang sesuai warna brand, tipografi, dan persona
                    target pasarmu.</p>
            </div>
            <div class="st" data-n="4">
                <span class="st-step-badge">STEP 04</span>
                <h3>Jahit Kode</h3>
                <p>Karya visual dihidupkan dengan kode kencang, responsif, aksesibilitas tinggi, dan struktur SEO yang
                    siap bersaing di halaman Google.</p>
            </div>
            <div class="st" data-n="5">
                <span class="st-step-badge">STEP 05</span>
                <h3>Quality Control</h3>
                <p>Kami uji menyeluruh di HP Android, iPhone, tablet, hingga layar laptop lebar. Kamu uji coba langsung
                    dan ajukan revisi sesuai paket.</p>
            </div>
            <div class="st" data-n="6">
                <span class="st-step-badge">STEP 06</span>
                <h3>Drop Day (Launch)</h3>
                <p>Website resmi meluncur ke publik! Kamu terima 100% kepemilikan penuh, akses panel admin, dan panduan
                    pengelolaan mandiri.</p>
            </div>
        </div>
    </section>

    <!-- SECTION: PAKET (DISTRO CLOTHING RACK & HANGTAGS) -->
    <section id="paket">
        <h2>Pilih potonganmu.</h2>
        <p style="margin-top:14px">Gantungan baju distro kami siap melayani berbagai skala brand. Klik salah satu label
            untuk membuka lembar spesifikasi (tech pack).</p>

        <div class="rack-container">
            <div class="rack-bar" aria-hidden="true">
                <div class="rack-bracket"></div>
                <div class="rack-pipe"></div>
                <div class="rack-bracket"></div>
            </div>

            <div class="tags" role="group" aria-label="Pilih paket website">
                <!-- Tag 1: Kaos Polos -->
                <button class="tg" data-k="kaos" aria-pressed="true">
                    <div class="tg-cord" aria-hidden="true"></div>
                    <div class="tg-eyelet" aria-hidden="true"></div>
                    <div class="tg-header">
                        <svg class="garment-icon" viewBox="0 0 64 64" fill="none" stroke-width="3"
                            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path
                                d="M20 12 L26 18 Q32 22 38 18 L44 12 L58 22 L50 34 L44 30 L44 54 L20 54 L20 30 L14 34 L6 22 Z" />
                            <path d="M26 18 Q32 22 38 18" />
                            <path d="M28 32 H36" />
                        </svg>
                        <span class="fit-badge">FIT: REGULAR • 1 PAGE</span>
                    </div>
                    <div>
                        <h3>Kaos Polos</h3>
                        <div class="price-tag">
                            <span class="cur-lbl">Rp</span>
                            <span class="pr">2.000.000</span>
                        </div>
                    </div>
                    <p class="tg-desc">Landing page 1 halaman panjang. Sangat cocok buat usaha baru, rilis single band,
                        produk viral, atau upgrade bio Instagram.</p>
                </button>

                <!-- Tag 2: Kemeja (Best Seller) -->
                <button class="tg" data-k="kemeja" aria-pressed="false">
                    <div class="badge-tape">★ PALING LARIS • BEST VALUE</div>
                    <div class="tg-cord" aria-hidden="true"></div>
                    <div class="tg-eyelet" aria-hidden="true"></div>
                    <div class="tg-header">
                        <svg class="garment-icon" viewBox="0 0 64 64" fill="none" stroke-width="3"
                            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path
                                d="M20 12 L25 20 L32 20 L39 20 L44 12 L58 22 L50 34 L44 30 L44 54 L20 54 L20 30 L14 34 L6 22 Z" />
                            <path d="M32 20 V54" />
                            <circle cx="32" cy="27" r="1.5" fill="currentColor" />
                            <circle cx="32" cy="35" r="1.5" fill="currentColor" />
                            <circle cx="32" cy="43" r="1.5" fill="currentColor" />
                            <rect x="23" y="27" width="6" height="8" rx="1" />
                        </svg>
                        <span class="fit-badge">FIT: COMFORT • 4-6 PAGES</span>
                    </div>
                    <div>
                        <h3>Kemeja</h3>
                        <div class="price-tag">
                            <span class="cur-lbl">Rp</span>
                            <span class="pr">4.500.000</span>
                        </div>
                    </div>
                    <p class="tg-desc">Company profile 4 hingga 6 halaman profesional. Pilihan utama kafe, studio
                        kreatif, firma, & UMKM yang ingin tampil matang.</p>
                </button>

                <!-- Tag 3: Jaket -->
                <button class="tg" data-k="jaket" aria-pressed="false">
                    <div class="tg-cord" aria-hidden="true"></div>
                    <div class="tg-eyelet" aria-hidden="true"></div>
                    <div class="tg-header">
                        <svg class="garment-icon" viewBox="0 0 64 64" fill="none" stroke-width="3"
                            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path
                                d="M20 14 L24 22 L40 22 L44 14 L60 24 L52 38 L45 34 L45 54 L19 54 L19 34 L12 38 L4 24 Z" />
                            <path d="M32 22 V54" stroke-dasharray="3 2" />
                            <path d="M24 22 L32 30 L40 22" />
                            <rect x="23" y="38" width="7" height="9" rx="1" />
                            <rect x="34" y="38" width="7" height="9" rx="1" />
                        </svg>
                        <span class="fit-badge">FIT: HEAVY • TOKO ONLINE</span>
                    </div>
                    <div>
                        <h3>Jaket</h3>
                        <div class="price-tag">
                            <span class="cur-lbl">Rp</span>
                            <span class="pr">9.000.000</span>
                        </div>
                    </div>
                    <p class="tg-desc">Toko online lengkap maksimal 30 produk, integrasi payment gateway otomatis
                        (QRIS/Transfer/E-Wallet), & hitung ongkir otomatis.</p>
                </button>
            </div>
        </div>

        <!-- Tech Pack Specification Panel -->
        <div class="techpack-panel" aria-live="polite">
            <div class="techpack-top">
                <div class="techpack-tag">
                    <span class="techpack-dot"></span>
                    <span>TECH PACK // LEMBAR JAHITAN KODE</span>
                </div>
                <div class="techpack-art" id="spec-art">ART. DW-KAOS-01</div>
            </div>

            <!-- Production Specs Strip (Horizontal, Clean, Balanced) -->
            <div class="techpack-stats-bar">
                <div class="stat-badge">
                    <span class="stat-lbl">⏱️ ESTIMASI WAKTU</span>
                    <span class="stat-val" id="stat-time">5 - 7 Hari Kerja</span>
                </div>
                <div class="stat-badge">
                    <span class="stat-lbl">✂️ JATAH REVISI</span>
                    <span class="stat-val" id="stat-rev">2 Kali Garansi</span>
                </div>
                <div class="stat-badge stat-invest">
                    <span class="stat-lbl">💰 TOTAL INVESTASI</span>
                    <span class="stat-val" id="stat-price">Rp 2.000.000</span>
                </div>
            </div>

            <!-- 2 Equal, Symmetrical Columns -->
            <div class="techpack-grid">
                <div class="techpack-col">
                    <div class="techpack-col-title">FITUR UTAMA & DETAIL JAHITAN</div>
                    <ul id="items" class="spec-list"></ul>
                </div>

                <div class="techpack-col techpack-right-col">
                    <div class="techpack-target-card">
                        <div class="techpack-col-title">🎯 COCOK BUAT SIAPA?</div>
                        <p class="target-desc" id="spec-target"></p>
                    </div>

                    <div class="techpack-perks-box">
                        <div class="techpack-col-title">📦 BONUS BAWA PULANG</div>
                        <div class="perks-list">
                            <div class="perk-item">
                                <span class="perk-badge">FREE</span>
                                <span>100% Hak Milik Source Code & Database</span>
                            </div>
                            <div class="perk-item">
                                <span class="perk-badge">FREE</span>
                                <span>Video Panduan 15 Menit kelola konten mandiri</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="techpack-bottom-bar">
                <div class="techpack-guarantee-pills">
                    <span class="pill">🔒 Bebas Biaya Konsultasi Awal</span>
                    <span class="pill">💸 Pembayaran Bertahap 50/50</span>
