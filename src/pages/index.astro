                        items.push({ name: '1x ' + (c.dataset.name || 'Add-on'), price: val });
                    }
                });

                var kilatCost = 0;
                if (k) {
                    kilatCost = p * 0.3;
                    items.push({ name: '1x Pengerjaan Kilat (+30%)', price: kilatCost });
                }

                cur = p + a + kilatCost;

                // Render live thermal receipt items
                var rcItems = $('#rc-items');
                if (rcItems) {
                    rcItems.innerHTML = items.map(function (item) {
                        return '<div class="rc-item"><span>' + item.name + '</span><span>' + rp(item.price) + '</span></div>';
                    }).join('');
                }

                $('#eta').textContent = 'Selesai sekitar ' + ET[p][k ? 1 : 0] + ' hari kerja.' + (k ? ' (Slot kilat prioritas aktif)' : '');

                // Formatted WhatsApp message with receipt breakdown
                var waBreakdown = items.map(function (it) { return '• ' + it.name + ': ' + rp(it.price); }).join('\n');
                var waMsg = 'Halo Distro Web, saya sudah simulasikan nota di website:\n\n' + waBreakdown + '\n\nTotal Estimasi: ' + rp(cur) + ' (belum termasuk hosting & domain).\nBoleh konsultasi ukur badan?';
                var waEl = $('#wa');
                if (waEl) {
                    waEl.href = 'https://wa.me/6285183324266?text=' + encodeURIComponent(waMsg);
                }
                var ctaWa = $('#cta-wa');
                if (ctaWa) {
                    ctaWa.href = 'https://wa.me/6285183324266?text=' + encodeURIComponent(waMsg);
                }
            }

            function tick() {
                shown += (cur - shown) * 0.18;
                if (Math.abs(cur - shown) < 1) shown = cur;
                $('#tot').textContent = rp(shown);
                requestAnimationFrame(tick);
            }

            document.querySelectorAll('.calc input').forEach(function (i) {
                i.addEventListener('change', calc);
            });
            calc();
            tick();
        })();
</script>
</Layout>
