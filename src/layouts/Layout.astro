---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Distro Web: Bukan Baju Obral | Studio Website Bandung',
  description = 'Template website itu kayak baju obral dipakai ribuan bisnis. Di Distro Web, websitemu kami jahit dari nol biar pas sama karakter brand dan audiensmu!'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Fraunces:ital,opsz,wght@0,9..144,600;1,9..144,500&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
</body>
</html>
